# Maintainer: LANDeck
pkgname=landeck
pkgver=0.9.29
pkgrel=1
pkgdesc="LAN device and service manager with an embedded WebKitGTK viewer"
arch=('x86_64')
url="https://github.com/Melieahs/LANDeck"
license=('unknown')
depends=('gtk3' 'webkit2gtk-4.1')
optdepends=('xclip: paste inside the embedded WebView')
source=("LANDeck-linux-x64-${pkgver}.tar.xz")
sha256sums=('fdfa1f9a8672ff8b0566ba12339d23732d5aa70a4d70f574fca4fc8cd7a3f70c')

package() {
  install -d "$pkgdir/usr/lib/landeck"
  cp -a "$srcdir/bundle/." "$pkgdir/usr/lib/landeck/"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/landeck" <<'LAUNCHER'
#!/bin/sh
exec /usr/lib/landeck/landeck "$@"
LAUNCHER

  install -Dm644 "$startdir/landeck.desktop" \
    "$pkgdir/usr/share/applications/landeck.desktop"
  install -Dm644 "$startdir/landeck.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/landeck.png"
}
