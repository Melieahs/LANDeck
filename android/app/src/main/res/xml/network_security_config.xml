<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local NAS/router/Docker UIs commonly use plain HTTP on the LAN. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
